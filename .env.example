# Public — safe to expose to the browser. Get these from the Neon Console
# (Auth tab and Data API tab) after enabling Managed Better Auth and the Data API.
NEXT_PUBLIC_NEON_AUTH_URL=https://ep-example.neonauth.c-2.us-east-2.aws.neon.build/neondb/auth
NEXT_PUBLIC_NEON_DATA_API_URL=https://ep-example.apirest.c-2.us-east-2.aws.neon.build/neondb/rest/v1

# Server/local-only — NEVER exposed to the browser or committed with a real value.
# Used only by scripts/migrate.ts and tests/contacts-validation.test.ts, both run
# locally with Node. The deployed app does not use this at runtime.
DATABASE_URL=postgresql://user:password@ep-example.us-east-2.aws.neon.tech/neondb?sslmode=require
